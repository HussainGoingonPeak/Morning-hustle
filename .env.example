VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Your secret key for the Bytez/Prodia API (for image generation)
VITE_BYTEZ_PRODIA_API_KEY="YOUR_BYTEZ_PRODIA_API_KEY"
